{
  "expo": {
    "name": "SUFIKER+ (Sugarzy Finance Tracker)",
    "slug": "sufiker-tracker",
    "owner": "eternalsugarzy",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE600"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneytracker.ios"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE600"
      },
      "package": "com.moneytracker.ios",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi mengakses foto untuk melampirkan struk transaksi.",
          "cameraPermission": "Izinkan aplikasi mengakses kamera untuk memotret struk transaksi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFE600"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "bc488bc2-4c9c-4a24-bb60-2bbed9e54c00"
      }
    }
  }
}
